  "item": [
    {
      "name": "The Spot API",
      "item": [
        {
          "name": "Perfil y configuración",
          "item": [
            {
              "name": "Mi Perfil",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/usuarios/me",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "usuarios",
                    "me"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Guardar cambios",
              "request": {
                "method": "PATCH",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"nombres\": \"Regina\",\r\n  \"apellidos\": \"Jiménez Meneses\",\r\n  \"fechaNacimiento\": \"2006-03-09\",\r\n  \"genero\": \"Femenino\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/usuarios/me",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "usuarios",
                    "me"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Perfil público",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/usuarios/Yisus0714",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "usuarios",
                    "Yisus0714"
                  ]
                }
              },
              "response": []
            }
          ],
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
              }
            ]
          }
        },
        {
          "name": "Registro y acceso",
          "item": [
            {
              "name": "Iniciar Sesión",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.environment.set(\"token\", pm.response.json().token);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"username\": \"regiiniita\",\r\n  \"password\": \"Usuario123!\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/sesiones",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "sesiones"
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Seguimiento",
          "item": [
            {
              "name": "Listar seguidos",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/usuarios/regiiniita/seguidos",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "usuarios",
                    "regiiniita",
                    "seguidos"
                  ]
                },
                "auth": {
                  "type": "noauth"
                },
                "description": "Devuelve los usuarios que sigue {username}. Es público: no necesita token. 200 con la lista."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"Devuelve una lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Seguir usuario",
              "request": {
                "method": "PUT",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/usuarios/me/seguidos/Yisus0714",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "usuarios",
                    "me",
                    "seguidos",
                    "Yisus0714"
                  ]
                },
                "description": "El usuario del token empieza a seguir a {username}. Necesita haber iniciado sesión. 204 sin cuerpo; repetirla no da error."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Dejar de seguir usuario",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/usuarios/me/seguidos/Yisus0714",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "usuarios",
                    "me",
                    "seguidos",
                    "Yisus0714"
                  ]
                },
                "description": "El usuario del token deja de seguir a {username}. Necesita haber iniciado sesión. 204 sin cuerpo."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                    ]
                  }
                }
              ]
            }
          ],
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
              }
            ]
          }
        }
      ]
    }
  ]
